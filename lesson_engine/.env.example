# DeepSeek（必填）
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
# 读题（图片 OCR）所用模型：deepseek-flash 支持图片输入，可替代千问视觉
DEEPSEEK_VISION_MODEL=deepseek-flash
# 读图/排课/复核/修复等只输出 JSON 的调用是否关闭思考（思考模型会把预算花在 reasoning 上：读图实测 39.2s → 4.1s，还容易被截断）
DEEPSEEK_DISABLE_THINKING=1
DEEPSEEK_FAST_PROVIDER=deepseek
MODEL_PROVIDER_FAST=deepseek
MODEL_PROVIDER_REASONING=deepseek
MODEL_PROVIDER_VISION=auto

# 阿里云百炼 / DashScope（可选）
# 填了优先用千问视觉读图；留空则用上面的 DEEPSEEK_VISION_MODEL（deepseek-flash）读图。
ALIYUN_API_KEY=
ALIYUN_API_FLAVOR=openai
# Anthropic 兼容网关示例：https://maas.qianwenaiapi.com/apps/anthropic
ALIYUN_WORKSPACE_ID=
ALIYUN_REGION=cn-beijing
# 普通 sk- Key 可以留空；填写 WorkspaceId 后会自动使用专属域名
ALIYUN_BASE_URL=
ALIYUN_VISION_FAST_MODEL=qwen3-vl-flash
ALIYUN_VISION_MODEL=qwen3-vl-plus
ALIYUN_VISION_MODEL_FALLBACKS=qwen-vl-max,qwen3-vl-max

# 本地服务
HOST=127.0.0.1
PORT=3210
MAX_IMAGE_BYTES=12582912
# 上传文档（PDF/Word/文本）取文的体积上限
MAX_DOCUMENT_BYTES=12582912

# 可选：有效阿里云视觉 Key 后启用截图审美评审
ALIYUN_ENABLE_VISUAL_CRITIC=false
